# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL + anon key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — bypasses RLS; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────────
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=you@example.com

# Absolute URL of the deployed site (used for auth redirects + share links).
# OPTIONAL on Vercel — the app falls back to Vercel's own domain automatically;
# set it only for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the Vercel cron endpoint. Set the same value in the
# Vercel project env; Vercel sends it as "Authorization: Bearer <secret>".
CRON_SECRET=generate-a-long-random-string

# Encrypts founders' read-only Stripe restricted keys at rest (AES-256-GCM).
# Required for self-serve listing / Stripe-verified MRR. Generate with:
#   openssl rand -hex 24
# Changing it orphans existing connections (they re-verify) — treat as stable.
STRIPE_KEY_ENCRYPTION_SECRET=generate-another-long-random-string
